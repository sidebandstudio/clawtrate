{
  "id": "clawtrate-bots",
  "name": "Clawtrate bots",
  "description": "Clawtrate's tools for bots: where a run came from and what a bot can do in Clawtrate; and bots' and agents' proposed changes for a person to decide.",
  "categories": ["developer-tools"],
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "gatewayMethodDispatch": ["authenticated-request"],
    "tools": ["clawtrate_here", "clawtrate_tasks", "clawtrate_bots"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "managers": {
        "type": "array",
        "maxItems": 64,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "createdAt"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "createdAt": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
