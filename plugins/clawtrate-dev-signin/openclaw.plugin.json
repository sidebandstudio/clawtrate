{
  "id": "clawtrate-dev-signin",
  "name": "Clawtrate development sign-ins",
  "description": "Development instances only: scripted sign-ins for the scripted provider acme, and a key method for globex, against the instance's own scripted model on loopback. No real provider, account or network beyond loopback.",
  "activation": {
    "onStartup": true
  },
  "providers": ["acme", "globex"],
  "setup": {
    "requiresRuntime": false
  },
  "providerAuthChoices": [
    {
      "provider": "acme",
      "method": "device-code",
      "choiceId": "acme-device-code",
      "choiceLabel": "Acme (scripted)",
      "choiceHint": "a link and a code",
      "groupId": "acme",
      "groupLabel": "Acme (scripted)",
      "credentialOnly": true,
      "appGuidedAuth": "device-code"
    },
    {
      "provider": "acme",
      "method": "browser",
      "choiceId": "acme-browser",
      "choiceLabel": "Acme in the browser (scripted)",
      "choiceHint": "paste the code back",
      "groupId": "acme",
      "groupLabel": "Acme (scripted)",
      "credentialOnly": true,
      "appGuidedAuth": "oauth"
    },
    {
      "provider": "acme",
      "method": "host",
      "choiceId": "acme-host",
      "choiceLabel": "Acme (scripted) on the gateway's machine",
      "choiceHint": "finishes on the gateway's machine",
      "groupId": "acme",
      "groupLabel": "Acme (scripted)",
      "credentialOnly": true,
      "appGuidedAuth": "oauth"
    },
    {
      "provider": "acme",
      "method": "callback",
      "choiceId": "acme-callback",
      "choiceLabel": "Acme (scripted), back to the gateway",
      "choiceHint": "the gateway's callback, or the address pasted back",
      "groupId": "acme",
      "groupLabel": "Acme (scripted)",
      "credentialOnly": true,
      "appGuidedAuth": "oauth"
    },
    {
      "provider": "acme",
      "method": "api-key",
      "choiceId": "acme-api-key",
      "choiceLabel": "Acme API key (scripted)",
      "choiceHint": "billed per token",
      "groupId": "acme",
      "groupLabel": "Acme (scripted)",
      "credentialOnly": true,
      "appGuidedSecret": true
    },
    {
      "provider": "globex",
      "method": "api-key",
      "choiceId": "globex-api-key",
      "choiceLabel": "Globex API key (scripted)",
      "choiceHint": "saved with the gateway's key method",
      "groupId": "globex",
      "groupLabel": "Globex (scripted)",
      "credentialOnly": true
    }
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["signinUrl"],
    "properties": {
      "signinUrl": {
        "type": "string"
      }
    }
  }
}
