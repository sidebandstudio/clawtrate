{
  "name": "@clawtrate/desktop",
  "productName": "Clawtrate",
  "description": "Your OpenClaw agents, orchestrated.",
  "author": "Clawtrate contributors",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite build && electron .",
    "build:web": "vite build --config vite.web.config.ts",
    "preview:web": "vite build --config vite.web.config.ts && node src/web-host/main.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "fixture:build": "vite build --config vite.fixture.config.ts",
    "fixture": "vite build --config vite.fixture.config.ts && vite preview --config vite.fixture.config.ts",
    "package:mac": "electron-vite build && node packaging/build.ts mac",
    "package:win": "electron-vite build && node packaging/build.ts win"
  },
  "dependencies": {
    "@clawtrate/core": "workspace:*",
    "@clawtrate/ui": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.1",
    "electron-vite": "6.0.0",
    "vite": "8.3.8"
  }
}
