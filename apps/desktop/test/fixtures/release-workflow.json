{
  "name": "Desktop release candidate",
  "on": {
    "workflow_dispatch": {
      "inputs": {
        "track": {
          "type": "choice",
          "description": "Update track",
          "options": ["stable", "nightly"],
          "required": true
        },
        "version": {
          "type": "string",
          "description": "Stable version (leave blank to calculate a nightly)",
          "required": false
        }
      }
    }
  },
  "permissions": {
    "contents": "read"
  },
  "env": {
    "TRACK": "${{ inputs.track }}",
    "CLAWTRATE_UPDATE_FEED_URL": "https://updates.example/stable/feed.json",
    "CLAWTRATE_NIGHTLY_UPDATE_FEED_URL": "https://updates.example/nightly/feed.json"
  },
  "jobs": {
    "select": {
      "runs-on": "ubuntu-latest",
      "timeout-minutes": 5,
      "outputs": {
        "version": "${{ steps.select.outputs.version }}",
        "epoch": "${{ steps.select.outputs.epoch }}",
        "date": "${{ steps.select.outputs.date }}"
      },
      "steps": [
        {
          "uses": "actions/checkout@v7",
          "with": {
            "persist-credentials": false
          }
        },
        {
          "uses": "actions/setup-node@v7",
          "with": {
            "node-version": 26,
            "package-manager-cache": false
          }
        },
        {
          "run": "node apps/desktop/packaging/unsigned-environment.ts"
        },
        {
          "id": "select",
          "env": {
            "REQUESTED": "${{ inputs.version }}"
          },
          "run": "SOURCE_DATE_EPOCH=$(date -u +%s)\nexport SOURCE_DATE_EPOCH\nversion=$(node apps/desktop/packaging/candidate-version.ts)\nbuild_date=$(date -u -d \"@$SOURCE_DATE_EPOCH\" +%Y-%m-%dT%H:%M:%S.000Z)\nprintf 'version=%s\\nepoch=%s\\ndate=%s\\n' \"$version\" \"$SOURCE_DATE_EPOCH\" \"$build_date\" >> \"$GITHUB_OUTPUT\"\n"
        }
      ]
    },
    "macos": {
      "needs": "select",
      "runs-on": "macos-15",
      "outputs": {
        "digests": "${{ steps.native.outputs.digests }}"
      },
      "timeout-minutes": 60,
      "env": {
        "SOURCE_DATE_EPOCH": "${{ needs.select.outputs.epoch }}",
        "VERSION": "${{ needs.select.outputs.version }}"
      },
      "steps": [
        {
          "uses": "actions/checkout@v7",
          "with": {
            "persist-credentials": false
          }
        },
        {
          "uses": "pnpm/action-setup@v6"
        },
        {
          "uses": "actions/setup-node@v7",
          "with": {
            "node-version": 26,
            "cache": "pnpm"
          }
        },
        {
          "run": "node apps/desktop/packaging/unsigned-environment.ts"
        },
        {
          "run": "pnpm install --frozen-lockfile"
        },
        {
          "shell": "bash",
          "run": "node apps/desktop/packaging/candidate-build.ts candidate \"$VERSION\" --unsigned-only"
        },
        {
          "id": "native",
          "shell": "bash",
          "run": "digests=$(node apps/desktop/packaging/check-unsigned.ts candidate \"$VERSION\")\necho \"digests=$digests\" >> \"$GITHUB_OUTPUT\"\n"
        },
        {
          "uses": "actions/upload-artifact@v7",
          "with": {
            "name": "build-macos-15",
            "path": "candidate/",
            "if-no-files-found": "error",
            "retention-days": 3
          }
        }
      ]
    },
    "windows": {
      "needs": "select",
      "runs-on": "windows-2025",
      "outputs": {
        "digests": "${{ steps.native.outputs.digests }}"
      },
      "timeout-minutes": 60,
      "env": {
        "SOURCE_DATE_EPOCH": "${{ needs.select.outputs.epoch }}",
        "VERSION": "${{ needs.select.outputs.version }}"
      },
      "steps": [
        {
          "run": "git config --global core.autocrlf false"
        },
        {
          "uses": "actions/checkout@v7",
          "with": {
            "persist-credentials": false
          }
        },
        {
          "uses": "pnpm/action-setup@v6"
        },
        {
          "uses": "actions/setup-node@v7",
          "with": {
            "node-version": 26,
            "cache": "pnpm"
          }
        },
        {
          "run": "node apps/desktop/packaging/unsigned-environment.ts"
        },
        {
          "run": "pnpm install --frozen-lockfile"
        },
        {
          "shell": "bash",
          "run": "node apps/desktop/packaging/candidate-build.ts candidate \"$VERSION\" --unsigned-only"
        },
        {
          "name": "Check the unpacked Windows app architecture",
          "run": "python -I apps/desktop/packaging/inspect-candidate.py unpacked-amd64 apps/desktop/dist/win-unpacked/Clawtrate.exe candidate/win-x64.json"
        },
        {
          "id": "native",
          "shell": "bash",
          "run": "digests=$(node apps/desktop/packaging/check-unsigned.ts candidate \"$VERSION\")\necho \"digests=$digests\" >> \"$GITHUB_OUTPUT\"\n"
        },
        {
          "uses": "actions/upload-artifact@v7",
          "with": {
            "name": "build-windows-2025",
            "path": "candidate/",
            "if-no-files-found": "error",
            "retention-days": 3
          }
        }
      ]
    },
    "assemble": {
      "needs": ["select", "macos", "windows"],
      "runs-on": "ubuntu-latest",
      "timeout-minutes": 15,
      "env": {
        "ELECTRON_SKIP_BINARY_DOWNLOAD": "1",
        "VERSION": "${{ needs.select.outputs.version }}",
        "MAC_DIGESTS": "${{ needs.macos.outputs.digests }}",
        "WIN_DIGEST": "${{ needs.windows.outputs.digests }}",
        "BUILD_DATE": "${{ needs.select.outputs.date }}"
      },
      "steps": [
        {
          "uses": "actions/checkout@v7",
          "with": {
            "persist-credentials": false
          }
        },
        {
          "uses": "pnpm/action-setup@v6"
        },
        {
          "uses": "actions/setup-node@v7",
          "with": {
            "node-version": 26,
            "cache": "pnpm"
          }
        },
        {
          "run": "pnpm install --frozen-lockfile"
        },
        {
          "uses": "actions/download-artifact@v8",
          "with": {
            "pattern": "build-*",
            "merge-multiple": true,
            "path": "candidate/"
          }
        },
        {
          "name": "Check the unsigned candidate",
          "run": "feed=$CLAWTRATE_UPDATE_FEED_URL\nother=$CLAWTRATE_NIGHTLY_UPDATE_FEED_URL\nif [[ \"$TRACK\" == nightly ]]; then feed=$CLAWTRATE_NIGHTLY_UPDATE_FEED_URL; other=$CLAWTRATE_UPDATE_FEED_URL; fi\nnode apps/desktop/packaging/release-plan.ts assemble candidate \"$TRACK\" \"$VERSION\" \"$GITHUB_SHA\" \"$BUILD_DATE\" \"$feed\" \"$other\"\nchecked=$(jq -er '[.files[].sha512] | join(\",\")' candidate/release-plan.json)\ntest \"$checked\" = \"$MAC_DIGESTS,$WIN_DIGEST\"\n"
        },
        {
          "uses": "actions/upload-artifact@v7",
          "with": {
            "name": "candidate-${{ needs.select.outputs.version }}",
            "path": "candidate/",
            "if-no-files-found": "error",
            "retention-days": 3
          }
        }
      ]
    }
  }
}
