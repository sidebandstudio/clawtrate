{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ES2024", "DOM"],
    // The plugins are plain JavaScript; their tests import them as they are.
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "e2e/**/*.ts",
    "visual/**/*.ts",
    "e2e-packaged/**/*.ts",
    "e2e-updates/**/*.ts",
    "playwright.updates.config.ts",
    "e2e-desktop/**/*.ts",
    "playwright.desktop.config.ts",
    "test/**/*.ts",
    "plugins/*/test/**/*.ts",
    "playwright.config.ts",
    "playwright.visual.config.ts",
    "playwright.packaged.config.ts",
    "vitest.config.ts",
    "eslint.config.js"
  ]
}
